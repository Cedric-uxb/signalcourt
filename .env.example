# Local server and append-only receipt database.
PORT=8787
DATABASE_PATH=./data/signalcourt.sqlite

# Keep this exact default unless RYO provides a different authenticated MCP endpoint.
RYO_MCP_URL=https://app-ryochan.com/api/mcp

# Leave credentials empty for deterministic demo mode. SignalCourt enters live mode only when
# every credential below and a valid publisher registry are configured.
RYO_MCP_KEY=
TAVILY_API_KEY=

# OpenAI-compatible server configuration. LLM_BASE_URL must be HTTPS.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Required for live mode. Map trusted registrable domains to publisher identities. Use at least
# two domains with two distinct publisher IDs so independent-source checks cannot count aliases
# or sibling sites as separate publishers. Replace these examples with your reviewed sources.
PUBLISHER_REGISTRY_JSON={"example.com":"publisher-a","bbc.co.uk":"publisher-b"}
